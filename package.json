{
  "name": "stellaflix",
  "productName": "Stellaflix",
  "version": "1.1.2",
  "description": "沉浸式音乐播放器，融合天气电台、歌词舞台、粒子视觉和 3D 歌单架。",
  "author": "Stellaflix",
  "license": "GPL-3.0-or-later",
  "main": "desktop/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyr0008/stellaflix.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "test:equalizer": "node --test test/equalizer/*.test.js",
    "test:lyrics": "node --test test/lyrics/*.test.js",
    "test:custom-source": "node --test test/custom-source/*.test.js",
    "test:custom-source:electron": "electron test/custom-source/electron-smoke.js",
    "test:video": "node scripts/kazumi_phase1_test.js && node scripts/sprint_a_test.js && node scripts/kazumi_phase2_bridge_test.js && node scripts/online_phase2_test.js",
    "test:video:e2e": "electron scripts/kazumi_e2e_electron.js",
    "test:video:live": "node scripts/kazumi_live_rule_test.js",
    "build:win": "electron-builder --win nsis",
    "build:win:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.stellaflix.desktop",
    "productName": "Stellaflix",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "build/**/*",
      "server.js",
      "dj-analyzer.js",
      "package.json",
      "!public/index.*.html",
      "public/index.html"
    ],
    "asar": false,
    "win": {
      "executableName": "Stellaflix",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Stellaflix",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "artifactName": "Stellaflix-${version}-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gyr0008",
        "repo": "stellaflix"
      }
    ]
  },
  "stellaflix": {
    "update": {
      "provider": "github",
      "owner": "gyr0008",
      "repo": "stellaflix",
      "preview": true,
      "preferMirrors": true,
      "mirrors": [
        "https://gh.llkk.cc/",
        "https://ghfast.top/",
        "https://gh-proxy.com/"
      ]
    }
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "NeteaseCloudMusicApi": "^4.32.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2",
    "vite": "^8.2.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gyr0008/stellaflix/issues"
  },
  "homepage": "https://github.com/gyr0008/stellaflix#readme"
}
